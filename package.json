{
  "name": "shubi-shot-director",
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Codex Skill-driven browser graybox camera previs.",
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "tsx server/index.ts --production",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "schemas:generate": "tsx scripts/generate-schemas.ts",
    "audit:public": "node scripts/audit-public-release.mjs",
    "verify": "pnpm schemas:generate && pnpm typecheck && pnpm test && pnpm lint && pnpm build && pnpm audit:public",
    "shubi": "tsx cli/director.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "0.182.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.182.0",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.7.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.9.0"
}
