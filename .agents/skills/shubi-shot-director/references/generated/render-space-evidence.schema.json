{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "solveId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "candidateId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "sceneSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "width": {
      "type": "integer",
      "minimum": 160,
      "maximum": 1920
    },
    "height": {
      "type": "integer",
      "minimum": 90,
      "maximum": 1080
    },
    "entities": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entityId": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "visiblePixelCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "isolatedPixelCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "boundsPx": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "minX": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "minY": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "maxX": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "maxY": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "minX",
                  "minY",
                  "maxX",
                  "maxY"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "centerDepthM": {
            "type": "number"
          }
        },
        "required": [
          "entityId",
          "visiblePixelCount",
          "isolatedPixelCount",
          "boundsPx",
          "centerDepthM"
        ],
        "additionalProperties": false
      }
    },
    "actorParts": {
      "maxItems": 1024,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actorId": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "partId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "visiblePixelCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "isolatedPixelCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "boundsPx": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "minX": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "minY": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "maxX": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "maxY": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "minX",
                  "minY",
                  "maxX",
                  "maxY"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "centerDepthM": {
            "type": "number"
          }
        },
        "required": [
          "actorId",
          "partId",
          "visiblePixelCount",
          "isolatedPixelCount",
          "boundsPx",
          "centerDepthM"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "solveId",
    "candidateId",
    "sceneSha256",
    "width",
    "height",
    "entities",
    "actorParts"
  ],
  "additionalProperties": false
}
