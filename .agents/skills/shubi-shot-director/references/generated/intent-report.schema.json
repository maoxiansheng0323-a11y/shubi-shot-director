{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 5
    },
    "operation": {
      "type": "string",
      "enum": [
        "create",
        "modify"
      ]
    },
    "allowPartial": {
      "type": "boolean"
    },
    "recognizedConstraints": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "environment",
              "entity-presence",
              "entity-removal",
              "actor-slot",
              "pose",
              "relationship",
              "contact",
              "position",
              "rotation",
              "scale",
              "visibility",
              "camera-height",
              "camera-angle",
              "camera-target",
              "focal-length",
              "framing",
              "output",
              "composition-safety",
              "spatial-region",
              "spatial-boundary",
              "spatial-opening",
              "spatial-connection",
              "entity-region-membership",
              "region-visibility",
              "lock-protection",
              "actor-limb-presence",
              "actor-blueprint-registration",
              "actor-blueprint-instance",
              "actor-blueprint-variant"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "targets": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          },
          "evidence": {
            "maxItems": 64,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "entity"
                    },
                    "entityId": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 64,
                      "pattern": "^[a-z][a-z0-9_-]*$"
                    }
                  },
                  "required": [
                    "type",
                    "entityId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "entity-property"
                    },
                    "entityId": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 64,
                      "pattern": "^[a-z][a-z0-9_-]*$"
                    },
                    "path": {
                      "type": "string",
                      "enum": [
                        "entity.kind",
                        "entity.parentId",
                        "entity.transform.positionM",
                        "entity.transform.rotation",
                        "entity.transform.scale",
                        "entity.visible",
                        "entity.lockMode",
                        "actor.slot",
                        "actor.pose",
                        "camera.heightM",
                        "camera.lens.focalLengthMm",
                        "camera.lens.sensorWidthMm",
                        "entity.body.limbPresence.upper_arm_l",
                        "entity.body.limbPresence.forearm_l",
                        "entity.body.limbPresence.hand_l",
                        "entity.body.limbPresence.upper_arm_r",
                        "entity.body.limbPresence.forearm_r",
                        "entity.body.limbPresence.hand_r",
                        "entity.body.limbPresence.upper_leg_l",
                        "entity.body.limbPresence.lower_leg_l",
                        "entity.body.limbPresence.foot_l",
                        "entity.body.limbPresence.upper_leg_r",
                        "entity.body.limbPresence.lower_leg_r",
                        "entity.body.limbPresence.foot_r",
                        "actor.blueprintInstance"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "entityId",
                    "path"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "scene-property"
                    },
                    "path": {
                      "type": "string",
                      "enum": [
                        "scene.activeCameraId",
                        "scene.output",
                        "scene.compositionGoals",
                        "scene.compositionGoals.framing",
                        "scene.compositionGoals.captionZone",
                        "scene.compositionGoals.sideUiZone",
                        "scene.compositionGoals.criticalEntityIds",
                        "scene.spatialLayout.regions",
                        "scene.spatialLayout.boundaries",
                        "scene.spatialLayout.openings",
                        "scene.spatialLayout.connections",
                        "scene.spatialLayout.memberships",
                        "scene.actorBlueprints"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "path"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "scene-constraint"
                    },
                    "constraintId": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 64,
                      "pattern": "^[a-z][a-z0-9_-]*$"
                    }
                  },
                  "required": [
                    "type",
                    "constraintId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "patch-operation"
                    },
                    "operationIndex": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255
                    }
                  },
                  "required": [
                    "type",
                    "operationIndex"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "kind",
          "required",
          "targets",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "unsupportedConstraints": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "UNSUPPORTED_CONSTRAINT",
              "UNRESOLVED_RELATION",
              "UNAPPLIED_CONSTRAINT"
            ]
          },
          "targetIds": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          }
        },
        "required": [
          "code"
        ],
        "additionalProperties": false
      }
    },
    "unresolvedRelations": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "UNSUPPORTED_CONSTRAINT",
              "UNRESOLVED_RELATION",
              "UNAPPLIED_CONSTRAINT"
            ]
          },
          "targetIds": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          }
        },
        "required": [
          "code"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "PARTIAL_APPLICATION",
              "APPROXIMATE_PLACEMENT"
            ]
          },
          "targetIds": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          }
        },
        "required": [
          "code"
        ],
        "additionalProperties": false
      }
    },
    "canApplySafely": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "operation",
    "allowPartial",
    "recognizedConstraints",
    "unsupportedConstraints",
    "unresolvedRelations",
    "warnings",
    "canApplySafely"
  ],
  "additionalProperties": false
}
